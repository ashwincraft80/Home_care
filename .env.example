# HomeCare environment template. Copy to .env.local and fill in. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — only put publishable values there.

# --- Mode ---------------------------------------------------------------------------------
# demo     = embedded Postgres (PGlite) with fictional seeded data and password-less personas.
# supabase = Supabase Auth + Postgres + Storage. All Supabase variables below are required.
# Production builds refuse to start without this set; there is no automatic fallback.
HOMECARE_MODE=demo

# Public base URL (used in invitation links and auth redirects).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo mode only ----------------------------------------------------------------------
# Where the demo database and uploads live (must be under .data/). Default: .data/demo
# HOMECARE_DEMO_DATA_DIR=.data/demo
# Signing key for demo session cookies (32+ chars). If unset, a random key is generated
# and stored in the demo data directory.
# DEMO_SESSION_SECRET=

# --- Supabase mode -----------------------------------------------------------------------
# Project URL and anon/publishable key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Used solely for private Storage uploads/downloads after the server has checked
# access. Never expose to the browser, logs or client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER ONLY. Postgres connection string for server-side queries (runs reads as the signed-in
# user under RLS, and writes after authorisation). Use the pooler "transaction" string in
# serverless deployments.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Private bucket created by the migrations.
SUPABASE_STORAGE_BUCKET=homecare-private

# --- Integrations (not implemented yet — boundaries only) --------------------------------
# SMS/OTP, email, WhatsApp Business, payments and maps have interfaces in lib/integrations
# but no provider is connected. Add provider credentials here when you implement them,
# starting with SANDBOX/TEST keys. Real payments must stay disabled until reviewed.
# SMS_PROVIDER_API_KEY=
# EMAIL_PROVIDER_API_KEY=
# WHATSAPP_BUSINESS_TOKEN=
# PAYMENT_GATEWAY_KEY_ID=          # test/sandbox key only
# PAYMENT_GATEWAY_KEY_SECRET=      # server only
# MAPS_API_KEY=
